# Скопируйте в backend/.env и заполните значения для целевой машины.
# На оффлайн-сервере с Docker Desktop обычно: DB_HOST=host.docker.internal

DB_NAME=infolake_db
DB_USER=infolake
DB_PASSWORD=change_me
DB_HOST=host.docker.internal
DB_PORT=5432

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,172.16.80.207

# CORS: при доступе через nginx (единый origin :80/:8080) обычно не требуется.
# Режим БЕЗ nginx (OFFLINE_DEPLOY_DIRECT.md): обязательно origin фронта с портом 5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://172.16.80.207:5173
CORS_ALLOW_ALL_ORIGINS=False

# URL фронтенда для ссылки «Открыть сайт» в Django admin.
# nginx: http://172.16.80.207  или  http://172.16.80.207:8080
# без nginx: http://172.16.80.207:5173
FRONTEND_URL=http://172.16.80.207:5173
