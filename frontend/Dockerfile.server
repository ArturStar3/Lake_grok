# Production-сборка: frontend dist + nginx (единая точка входа).
# Собирается на машине с интернетом, на оффлайн-машине: docker load + up --no-build.

FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

ARG VITE_API_URL=
ARG VITE_TILESERVER_URL=/tiles
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_TILESERVER_URL=$VITE_TILESERVER_URL
ENV VITE_ENABLE_HMR=false

RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY deploy/upstream-watchdog.sh /docker-entrypoint.d/40-upstream-watchdog.sh
RUN sed -i 's/\r$//' /docker-entrypoint.d/40-upstream-watchdog.sh \
    && chmod +x /docker-entrypoint.d/40-upstream-watchdog.sh
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
