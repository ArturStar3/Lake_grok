{
  "version": 8,
  "name": "Overlay: Roads",
  "metadata": {
    "openmaptiles:version": "3.x",
    "infolake:overlay": true
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "mbtiles://{openmaptiles}"
    }
  },
  "glyphs": "{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "rgba(0,0,0,0)"
      }
    },
    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["all", ["in", "class", "minor", "service", "track"], ["!in", "brunnel", "bridge", "tunnel"]],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#b3aca0",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 10, 0, 11, 0.7, 13, 1],
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.6, 14, 4, 18, 9, 20, 13]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["all", ["in", "class", "minor", "service", "track"], ["!in", "brunnel", "bridge", "tunnel"]],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#ffffff",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 10, 0, 11, 0.7, 13, 1],
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.4, 14, 3, 18, 7, 20, 10]
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": ["all", ["==", "class", "path"], ["!in", "brunnel", "bridge", "tunnel"]],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#b09a80",
        "line-dasharray": [1.5, 0.75],
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0, 14, 0.85],
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.6, 16, 1.6, 20, 3]
      }
    },
    {
      "id": "road-secondary-tertiary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 7,
      "filter": ["all", ["in", "class", "secondary", "tertiary"], ["!=", "ramp", 1], ["!in", "brunnel", "bridge", "tunnel"]],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#b8901f",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 7, 0, 9, 0.8, 11, 1],
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.8, 12, 3.5, 14, 6, 18, 11, 20, 15]
      }
    },
    {
      "id": "road-secondary-tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 7,
      "filter": ["all", ["in", "class", "secondary", "tertiary"], ["!=", "ramp", 1], ["!in", "brunnel", "bridge", "tunnel"]],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#ffe082",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 7, 0, 9, 0.8, 11, 1],
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.5, 12, 2.6, 14, 4.6, 18, 9, 20, 13]
      }
    },
    {
      "id": "road-trunk-primary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": ["all", ["in", "class", "trunk", "primary"], ["!=", "ramp", 1], ["!in", "brunnel", "bridge", "tunnel"]],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#c46a1c",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 5, 0, 7, 0.7, 9, 1],
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.8, 10, 2.8, 14, 6.5, 18, 12, 20, 16]
      }
    },
    {
      "id": "road-trunk-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": ["all", ["in", "class", "trunk", "primary"], ["!=", "ramp", 1], ["!in", "brunnel", "bridge", "tunnel"]],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#ffb84d",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 5, 0, 7, 0.7, 9, 1],
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.5, 10, 2, 14, 5, 18, 10, 20, 14]
      }
    },
    {
      "id": "road-motorway-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 4,
      "filter": ["all", ["==", "class", "motorway"], ["!=", "ramp", 1], ["!in", "brunnel", "bridge", "tunnel"]],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#b0521a",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 4, 0, 5, 0.6, 7, 1],
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.8, 8, 2.6, 12, 6, 16, 11, 20, 18]
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 4,
      "filter": ["all", ["==", "class", "motorway"], ["!=", "ramp", 1], ["!in", "brunnel", "bridge", "tunnel"]],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#ff8a33",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 4, 0, 5, 0.6, 7, 1],
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.5, 8, 1.8, 12, 4.5, 16, 9, 20, 15]
      }
    }
  ]
}
