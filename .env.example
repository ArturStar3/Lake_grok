# Порт nginx на хосте (единая точка входа в приложение).
# На Windows порт 80 часто занят HTTP.sys/IIS — используйте 8080:
NGINX_HTTP_PORT=8080

# Режим БЕЗ nginx (docker-compose.direct.yml) — три отдельных порта:
# BACKEND_HTTP_PORT=8000
# TILESERVER_HTTP_PORT=8080
# FRONTEND_HTTP_PORT=5173
# FRONTEND_PUBLIC_URL=http://172.16.80.207:5173

# Production с PostgreSQL 17 в Docker (docker-compose.postgres.yml).
# Должны совпадать с DB_NAME / DB_USER / DB_PASSWORD в backend/.env:
# POSTGRES_DB=infolake_db
# POSTGRES_USER=infolake
# POSTGRES_PASSWORD=change_me
# POSTGRES_HOST_PORT=5431
# На Windows/Docker Desktop НЕ задавайте POSTGRES_DATA_DIR (bind mount NTFS → initdb: permissions).
# Данные — named volume infolake_pgdata; диск Q:/D: — через Disk image location Docker Desktop
# (см. OFFLINE_DEPLOY_PROD_POSTGRES.md). Только на Linux-хосте:
# POSTGRES_DATA_DIR=/srv/infolake/pgdata
# (пустая папка + chown -R 999:999)
