# Порт nginx на хосте (единая точка входа в приложение).
# На Windows порт 80 часто занят HTTP.sys/IIS — используйте 8080:
NGINX_HTTP_PORT=8080

# Режим БЕЗ nginx (docker-compose.direct.yml) — три отдельных порта:
# BACKEND_HTTP_PORT=8000
# TILESERVER_HTTP_PORT=8080
# FRONTEND_HTTP_PORT=5173
# FRONTEND_PUBLIC_URL=http://172.16.80.207:5173

